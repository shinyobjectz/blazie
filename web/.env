# Public build-time config. Not secrets — NEXT_PUBLIC_* is baked into the
# static bundle by definition, so nothing here may ever be one.
#
# The API is proxied through Cloudflare so the console can reach it over HTTPS;
# a page on blazie.dev cannot call a bare-IP http:// origin at all, whatever
# the CORS headers say.
NEXT_PUBLIC_BLAZIE_URL=https://api.blazie.dev
NEXT_PUBLIC_GITHUB_CLIENT_ID=Ov23liU8M5D4hy3RFrRM
